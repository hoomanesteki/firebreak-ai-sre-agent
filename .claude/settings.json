{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git rebase -i *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./labels/**)"
    ],
    "ask": [
      "Bash(git tag *)"
    ]
  }
}
