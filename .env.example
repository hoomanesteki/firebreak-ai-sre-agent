# Copy to .env and edit. Every variable is optional in Phase 0; later
# phases add required ones and the service refuses to start without them.

# Where evidence comes from: bundle or live.
FIREBREAK_DATA_MODE=bundle

# How model calls are served: stub, replay, local, or api.
FIREBREAK_LLM_MODE=stub

# OpenAI-compatible endpoint. Point this at Ollama for local models,
# or at a gateway. Required only when FIREBREAK_LLM_MODE=api.
# FIREBREAK_LLM_BASE_URL=http://localhost:11434/v1
# FIREBREAK_LLM_API_KEY=

FIREBREAK_LOG_LEVEL=INFO
